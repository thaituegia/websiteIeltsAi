# Local MongoDB (npm run mongo:start). Atlas/production credentials belong only in secrets.
MONGODB_URI=mongodb://127.0.0.1:27017/ielts_ai
PORT=3001
WEB_PORT=5173
NODE_ENV=development
APP_ORIGIN=
TRUST_PROXY=false
MAX_LEARNERS=2
# Only the two phone accounts in private server configuration can log in.
DUO_ENABLED=true
DUO_CREDENTIALS_FILE=
# Alternatively supply private, hash-only JSON via DUO_ACCOUNTS_JSON (never VITE_*).
DUO_ACCOUNTS_JSON=
DUO_GATE_INTERVAL=5
DUO_SESSIONS_PER_BAND=20
DUO_PASS_PERCENT=70
DUO_STRICT_RETAKE_MODE=false
# Optional per-band session counts, e.g. {"7.5":20,"8":30}.
DUO_SESSIONS_BY_BAND=
DEMO_ENABLED=false

# Optional server-only OpenAI integration. Leave blank until a real key is supplied securely.
IELTS_OPENAI_API_KEY=
CONTENT_MODEL=gpt-4o
EXTRACTOR_MODEL=gpt-4o
SCORING_MODEL=gpt-4o
TRANSCRIPTION_MODEL=whisper-1
# Real WAV audio assessment; transcript alone does not provide pronunciation bands.
SPEAKING_AUDIO_MODEL=gpt-audio

# Optional real ElevenLabs voice IDs from your account, not sample IDs.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_BRITISH=
ELEVENLABS_VOICE_AMERICAN=
ELEVENLABS_VOICE_AUSTRALIAN=
ELEVENLABS_MODEL=eleven_v3

# Optional real Azure pronunciation measurement; aliases also supported for local use.
IELTS_AZURE_SPEECH_KEY=
IELTS_AZURE_SPEECH_REGION=
