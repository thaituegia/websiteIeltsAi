{
  "name": "website-ielts-ai",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "build:release": "tsc -p tsconfig.client.json && tsc -p tsconfig.server.json && vite build",
    "typecheck": "tsc --noEmit",
    "start": "tsx server/index.ts",
    "seed": "tsx scripts/seed.ts",
    "mongo": "node scripts/mongo.mjs",
    "mongo:start": "node scripts/mongo.mjs start",
    "mongo:status": "node scripts/mongo.mjs status",
    "mongo:stop": "node scripts/mongo.mjs stop",
    "audit:content": "tsx scripts/audit-content.ts",
    "audit:expansion": "tsx scripts/audit-expanded-content.ts",
    "audit:band8": "tsx scripts/audit-band8.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "audit:fresh": "tsx scripts/audit-fresh-bank.ts",
    "audit:references": "tsx scripts/audit-exam-references.ts",
    "bank:upgrade:inspect": "tsx server/bank-upgrade-cli.ts inspect",
    "bank:inspect": "tsx server/bank-reset-cli.ts inspect",
    "bank:verify": "tsx server/bank-reset-cli.ts verify"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "lucide-react": "^0.468.0",
    "microsoft-cognitiveservices-speech-sdk": "^1.52.0",
    "mongodb": "^6.21.0",
    "multer": "^2.0.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.3",
    "ts-fsrs": "^5.2.3",
    "tsx": "^4.20.6",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.7.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "typescript": "^5.9.3",
    "vite": "^7.1.9"
  }
}
