CONTENT_MODEL=gpt-6.1-sol
SCORING_MODEL=gpt-6.1-sol
EXTRACTOR_MODEL=gpt-6.1-sol
TRANSLATION_MODEL=gpt-6.1-sol
TRANSCRIPTION_MODEL=whisper-1
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_BRITISH=
ELEVENLABS_VOICE_AMERICAN=
ELEVENLABS_VOICE_AUSTRALIAN=
ELEVENLABS_MODEL=eleven_v3
IELTS_AZURE_SPEECH_KEY=
IELTS_AZURE_SPEECH_REGION=
